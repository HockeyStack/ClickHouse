SELECT
    in(lower(__table1.s), ('a', 'b', 'c')) AS r,
    count() AS `count()`,
    any(__table1.j) AS `any(j)`
FROM
(
    SELECT
        toString(__table2.number) AS s,
        concat(toString(__table2.number), 'x') AS j
    FROM numbers(10) AS __table2
) AS __table1
GROUP BY in(lower(__table1.s), ('a', 'b', 'c'))
0	7	1
1	3	1
SELECT count() AS `count()`
FROM
t1 AS __table1
WHERE and(notIn(__table1.l, ('1x', '2x', '3x')), in(__table1.s, ('1', '4', '5')))
2
SELECT count() AS `count()`
FROM
(
    SELECT toString(__table2.number) AS s
    FROM numbers(10) AS __table2
) AS __table1
WHERE 0
SELECT count() AS `count()`
FROM
(
    SELECT toString(__table2.number) AS s
    FROM numbers(10) AS __table2
) AS __table1,
(
    SELECT toString(__table4.number) AS s
    FROM numbers(10) AS __table4
) AS __table3
WHERE or(equals(__table3.s, '3'), in(__table1.s, ('1', '2', '4')))
37
